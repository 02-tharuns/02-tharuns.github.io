# Copy to .env for local dev (uvicorn does not auto-load it; use
# `set -a && source .env && set +a` or `env $(cat .env | xargs) uvicorn ...`,
# or your process manager's env-file support). In production (Render, Azure
# Container Apps) set these as real environment variables / secrets instead.

# --- CORS -----------------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:5173,https://02-tharuns.github.io

# --- generation (Groq) -------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- retrieval: Qdrant Cloud --------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=chappie_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- retrieval: reranking / fusion tuning -------------------------------------
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
USE_DENSE=true
USE_RERANKER=true
RRF_K=60
BM25_TOP_N=12
DENSE_TOP_N=12
FUSION_TOP_N=8
RERANK_TOP_N=3

# --- corpus / observability ---------------------------------------------------
CONTENT_DIR=../content
BM25_CORPUS_PATH=data/corpus.json
DB_PATH=data/chappie.db

# --- the separate AI SRE agent project posts here -----------------------------
AGENT_EVENTS_TOKEN=

# --- contact form + gap/report notifications (Gmail App Password) ------------
OWNER_NAME=Tharun
CONTACT_EMAIL=tharunmysuru@gmail.com
CONTACT_NOTIFY_EMAIL=
GAP_NOTIFY_EMAIL=
# Where "a visitor flagged this answer as wrong/unhelpful" emails go
# (POST /report — see app/report/routes.py). Falls back to GAP_NOTIFY_EMAIL
# if unset, so you don't have to configure a second address unless you want
# reports and gap notifications routed differently.
REPORT_NOTIFY_EMAIL=
SMTP_USER=
SMTP_APP_PASSWORD=

# --- rate limiting (per-instance, in-memory) ----------------------------------
RATE_LIMIT_PER_MIN=6
RATE_LIMIT_PER_DAY=40
RATE_LIMIT_GLOBAL_PER_DAY=400
